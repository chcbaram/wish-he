{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-configure",
      "type": "shell",
      "windows": {
        "command": "cmake -S . -B build -G 'MinGW Makefiles'"
      },
      "command": "cmake -S . -B build",
      "problemMatcher": []
    },
    {
      "label": "build-build",
      "type": "shell",
      "windows": {
        "command": "cmake -S . -B build -G 'MinGW Makefiles'; cmake --build build -j20"
      },
      "command": "cmake -S . -B build; cmake --build build -j20",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-clean",
      "type": "shell",
      "command": "cmake --build build --target clean",
      "problemMatcher": []
    },

    // ── 기록 ────────────────────────────────────────────────────────────────
    //
    // 평소에는 flash-usb 를 쓴다. 배선이 필요 없다.
    // 보드를 먼저 업데이트 모드로 넣어야 한다 — CLI 에서 `reset boot`.
    //
    {
      "label": "flash-usb",
      "detail": "USB(부트로더 HID)로 기록. 배선 불필요. 먼저 CLI 에서 reset boot.",
      "type": "shell",
      "command": "python3 tools/iap_update.py build/wish-he.bin",
      "dependsOn": "build-build",
      "problemMatcher": [],
      "presentation": { "clear": true },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "flash-usb-info",
      "detail": "업데이트 모드로 들어온 보드가 보이는지 확인 (기록하지 않음)",
      "type": "shell",
      "command": "python3 tools/iap_update.py --info",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "label": "keys-track",
      "detail": "라이브 트래킹 — 눌린 깊이를 실제 배치대로. Ctrl+C 로 끝낸다.",
      "type": "shell",
      "command": "python3 tools/he_track.py",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "label": "keys-track-rate",
      "detail": "라이브 트래킹 스냅샷/초만 측정",
      "type": "shell",
      "command": "python3 tools/he_track.py --rate",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "label": "flash-jtag",
      "detail": "JTAG(FT2232 + HPMicro OpenOCD)로 0x80020000 에 기록. 앱이 죽었을 때.",
      "type": "shell",
      "command": "${env:HPM_RISCV_OPENOCD_PATH}/openocd -s tools/openocd -f hpm5361-fw.cfg -c \"adapter speed 4000\" -c \"init\" -c \"reset halt\" -c \"flash probe 0\" -c \"flash write_image erase build/wish-he.bin 0x80020000 bin\" -c \"verify_image build/wish-he.bin 0x80020000 bin\" -c \"reset run\" -c \"exit\"",
      "dependsOn": "build-build",
      "problemMatcher": []
    },
    {
      "label": "openocd-server",
      "type": "shell",
      "command": "${env:HPM_RISCV_OPENOCD_PATH}/openocd -s tools/openocd -f hpm5361-fw.cfg",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
