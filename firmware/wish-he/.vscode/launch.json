{
  // cortex-debug 은 ARM 전용이라 RISC-V 에서는 쓸 수 없다.
  // MS C/C++ 확장(cppdbg)으로 OpenOCD 를 GDB 서버로 띄운다.
  //
  // 필요한 환경변수 (~/.zshenv 에 둘 것 — .zshrc 는 대화형 셸에서만 읽혀서
  // VS Code 가 로그인 셸로 환경을 수집할 때 보이지 않는다)
  //   export HPM_RISCV_TOOLCHAIN_DIR="$HOME/hdd/tools/xpack-riscv-none-elf-gcc-13.4.0-1"
  //   export HPM_RISCV_OPENOCD_PATH="$HOME/hdd/tools/hpmicro/openocd/bin"
  //   export HPM_RISCV_GDB="$HOME/hdd/tools/xpack-riscv-none-elf-gcc-12.2.0-3/bin/riscv-none-elf-gdb-py3"
  //
  // 빌드는 13.4.0-1, 디버깅용 gdb 만 12.2.0-3 을 쓴다.
  // xpack 13.4.0-1 의 gdb 16.3 (arm64 macOS) 은 에러를 던지는 모든 명령에서
  // uncaught gdb_exception_error 로 abort 한다 (SIGABRT, exit 134).
  // cppdbg 가 시작 직후 보내는 "set debuginfod enabled on" 에서 바로 죽어서
  // 디버깅을 시작할 수 없다. gdb 12.1 은 정상적으로 에러만 내고 계속 진행한다.
  // gdb 12.1 이 GCC 13 의 DWARF 를 읽는 데는 문제 없다.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HPM5361 Debug (OpenOCD)",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/wish60-he.elf",
      "MIMode": "gdb",
      "miDebuggerPath": "${env:HPM_RISCV_GDB}",
      "miDebuggerServerAddress": "localhost:3333",
      "debugServerPath": "${env:HPM_RISCV_OPENOCD_PATH}/openocd",
      "debugServerArgs": "-s ${workspaceFolder}/tools/openocd -f hpm5361-fw.cfg",
      "serverStarted": "Listening on port 3333 for gdb connections",
      "filterStderr": true,
      // true  : 플래시 기록 + reset halt 후 _start(start.S) 에서 정지.
      //         거기서 F5 를 누르면 에디터에 찍어둔 브레이크포인트로 진행한다.
      // false : 바로 계속 실행. 에디터 브레이크포인트(F9)에서만 멈춘다.
      //
      // postRemoteConnectCommands 에 "tbreak main" 을 넣어 main 에서 자동 정지시키는
      // 방식은 쓸 수 없다. cppdbg 가 자기 브레이크포인트 목록과 동기화하면서
      // 콘솔로 만든 것을 지워버려 그냥 지나친다. (gdb 단독으로는 정상 동작한다)
      "stopAtConnect": true,
      "preLaunchTask": "build-build",
      "setupCommands": [
        { "text": "set architecture riscv:rv32" },
        { "text": "set remotetimeout 60" },
        { "text": "set mem inaccessible-by-default off" }
      ],
      "postRemoteConnectCommands": [
        // 순서 중요 : load 는 PC 를 ELF 진입점(_start)으로 옮길 뿐이라
        // ROM 부트로더가 XPI0 를 설정하지 않은 상태가 된다.
        // reset halt 로 ROM 을 다시 태워야 XIP 부팅 경로를 그대로 밟는다.
        { "text": "load" },
        { "text": "monitor reset halt" }
      ],
      "launchCompleteCommand": "exec-continue"
    },
    {
      // 이미 동작 중인 펌웨어에 기록 없이 붙는다.
      "name": "HPM5361 Attach (OpenOCD)",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/wish60-he.elf",
      "MIMode": "gdb",
      "miDebuggerPath": "${env:HPM_RISCV_GDB}",
      "miDebuggerServerAddress": "localhost:3333",
      "debugServerPath": "${env:HPM_RISCV_OPENOCD_PATH}/openocd",
      "debugServerArgs": "-s ${workspaceFolder}/tools/openocd -f hpm5361-fw.cfg",
      "serverStarted": "Listening on port 3333 for gdb connections",
      "filterStderr": true,
      "stopAtConnect": true,
      "setupCommands": [
        { "text": "set architecture riscv:rv32" },
        { "text": "set remotetimeout 60" },
        { "text": "set mem inaccessible-by-default off" }
      ]
    }
  ]
}
