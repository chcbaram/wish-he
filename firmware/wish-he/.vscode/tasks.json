{
  "version": "2.0.0",
  "tasks": [
    // ── 빌드 ────────────────────────────────────────────────────────────────
    //
    // ★ 보드를 고르면 그에 맞는 링커 스크립트·후처리·PID 가 따라온다.
    //   tools/build.sh 가 키보드->보드 대응과 폴더 이름(build/<키보드>/)을 갖는다.
    //   여기서 cmake 를 직접 부르면 그 대응이 두 곳으로 갈라진다.
    //
    {
      "label": "build-build",
      "detail": "키보드를 골라 빌드한다 (build/<키보드>/)",
      "type": "shell",
      "command": "tools/build.sh ${input:keyboard}",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-clean",
      "detail": "그 키보드 빌드를 지우고 처음부터",
      "type": "shell",
      "command": "tools/build.sh ${input:keyboard} -c",
      "problemMatcher": []
    },

    // ── 기록 ────────────────────────────────────────────────────────────────
    //
    // 평소에는 flash-usb 를 쓴다. 배선이 필요 없다.
    // 보드를 먼저 업데이트 모드로 넣어야 한다 — CLI 에서 `reset boot`.
    //
    {
      "label": "flash-usb",
      "detail": "wish60-he-7u 를 USB 로 기록 (자체 IAP). 먼저 CLI 에서 reset boot.",
      "type": "shell",
      "command": "python3 tools/iap_update.py build/wish60-he-7u/wish60-he-7u.bin",
      "dependsOn": "build-build",
      "problemMatcher": [],
      "presentation": { "clear": true },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "flash-usb-61",
      "detail": "wish61-he 를 USB 로 기록 (벤더 IAP). 부트로더 진입까지 알아서 한다.",
      "type": "shell",
      "command": "python3 tools/flash.py build/wish61-he/wish61-he-tag.bin",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "label": "flash-usb-info",
      "detail": "업데이트 모드로 들어온 보드가 보이는지 확인 (기록하지 않음)",
      "type": "shell",
      "command": "python3 tools/iap_update.py --info",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "label": "keys-track",
      "detail": "라이브 트래킹 — 눌린 깊이를 실제 배치대로. Ctrl+C 로 끝낸다.",
      "type": "shell",
      "command": "python3 tools/he_track.py --pid ${input:pid}",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "label": "keys-track-rate",
      "detail": "라이브 트래킹 스냅샷/초만 측정",
      "type": "shell",
      "command": "python3 tools/he_track.py --pid ${input:pid} --rate",
      "problemMatcher": [],
      "presentation": { "clear": true }
    },
    {
      "label": "flash-jtag",
      "detail": "JTAG(FT2232 + HPMicro OpenOCD)로 0x80020000 에 기록. 앱이 죽었을 때.",
      "type": "shell",
      "command": "${env:HPM_RISCV_OPENOCD_PATH}/openocd -s tools/openocd -f hpm5361-fw.cfg -c \"adapter speed 4000\" -c \"init\" -c \"reset halt\" -c \"flash probe 0\" -c \"flash write_image erase build/wish60-he-7u/wish60-he-7u.bin 0x80020000 bin\" -c \"verify_image build/wish60-he-7u/wish60-he-7u.bin 0x80020000 bin\" -c \"reset run\" -c \"exit\"",
      "dependsOn": "build-build",
      "problemMatcher": []
    },
    {
      "label": "openocd-server",
      "type": "shell",
      "command": "${env:HPM_RISCV_OPENOCD_PATH}/openocd -s tools/openocd -f hpm5361-fw.cfg",
      "isBackground": true,
      "problemMatcher": []
    }
    ],

  // ── 고르는 것 ───────────────────────────────────────────────────────────
  //
  // ★ 보드가 둘이다. 기본값을 두되 **매번 묻게** 한다 — 엉뚱한 보드에 굽는 것이
  //   이 저장소에서 제일 흔한 사고다.
  //
  "inputs": [
    {
      "id": "keyboard",
      "type": "pickString",
      "description": "어느 키보드를 빌드하나",
      "options": ["wish60-he-7u", "wish61-he"],
      "default": "wish60-he-7u"
    },
    {
      "id": "pid",
      "type": "pickString",
      "description": "어느 보드에 붙나 (USB PID)",
      "options": ["0x5304", "0x5305"],
      "default": "0x5304"
    }
  ]
}